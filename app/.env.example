# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# This app loads these from the process environment (see lib/config.js).

# The store's PERMANENT myshopify.com domain (not the custom domain).
SHOPIFY_STORE=himangs-tiramisu.myshopify.com

# Admin API access token from your custom app (starts with shpat_).
# Needs scopes: read_products, read_customers, write_customers,
#               read_draft_orders, write_draft_orders, read_orders.
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API version to pin.
SHOPIFY_API_VERSION=2024-10

# Webhook signing secret — used to verify incoming order webhooks.
# NOT the same as the API secret. Leave blank to skip verification in dev
# (the app will warn loudly).
SHOPIFY_WEBHOOK_SECRET=

# Port for this local server.
PORT=3000
