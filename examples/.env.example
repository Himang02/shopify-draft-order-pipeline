# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.
#
# These examples read from the process environment. You can either
# `export` each variable, or use a tool that loads a .env file.

# The store's PERMANENT myshopify.com domain (not the custom domain).
SHOPIFY_STORE=himangs-tiramisu.myshopify.com

# Admin API access token from your custom app (starts with shpat_).
# See 03-rest-api/01-authentication-and-access-tokens.md
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret — used to verify incoming webhooks (Section 04).
# This is NOT the same as the API secret. See 04-webhooks/.
SHOPIFY_WEBHOOK_SECRET=

# IDs used by the draft-order examples (fill in after creating them).
VARIANT_ID=9002
CUSTOMER_ID=7001
DRAFT_ORDER_ID=5001
